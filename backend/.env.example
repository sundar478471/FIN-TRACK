# FIN TRACK API Configuration

# Port to run the server on
PORT=5000

# CockroachDB Connection String (PostgreSQL compatible)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=verify-full
# Example CockroachDB Serverless connection string.
# Omit or leave empty to operate in Local Mock Mode (uses in-memory & db.json).
DATABASE_URL="postgresql://username:password@localhost:26257/fintrack?schema=public"

# Path to the Firebase Service Account Key JSON file
# Used to verify user authentications via Firebase Admin SDK.
# Omit or leave empty to operate in Local Mock Mode (uses bearer mock tokens).
FIREBASE_SERVICE_ACCOUNT_KEY=""
