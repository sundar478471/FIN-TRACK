# FIN TRACK API Configuration

# Port to run the server on
PORT=5000

# Turso Cloud Database Connection String (libsql://)
# Format: libsql://<database-name>-<user>.turso.io
DATABASE_URL="libsql://your-turso-database-url"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Path to the Firebase Service Account Key JSON file
# Used to verify user authentications via Firebase Admin SDK.
FIREBASE_SERVICE_ACCOUNT_KEY="service-account.json"
