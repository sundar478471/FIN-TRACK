# FIN TRACK - Client Configuration

# The URL of the Express API backend server
VITE_API_URL="http://localhost:5000/api"

# Firebase Client SDK Configuration keys
# Retrieve these from your Firebase Console under Project Settings > Web App
# Leave these empty to run in Local Mock Auth mode automatically.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
